{
  "schema_version": 1,
  "common": {},
  "commands": {
    "fit": {
      "frequency_weights": "default=1;1GHz=3;2GHz:4GHz=2",
      "passivity_margin": 0.001,
      "passivity_mode": "auto",
      "progress_interval": 25,
      "reciprocity_mode": "enforce",
      "reciprocity_tolerance": 1e-06,
      "seed": 1234
    },
    "optimize": {
      "adaptive_category_balance": 0.5,
      "require_passive": true,
      "selection_metric": "weighted_evm_pct",
      "trial_seed_mode": "fixed",
      "trial_worst_plots": 0
    }
  },
  "models": {
    "dnn": {
      "commands": {
        "fit": {
          "output_domain": "s",
          "sparam_weights": "diag=1;offdiag=0.2"
        }
      }
    },
    "kbnn": {
      "commands": {
        "fit": {
          "coarse_sparam_weights": "diag=1;offdiag=0.2",
          "mode": "residual",
          "sparam_weights": "diag=1;offdiag=0.2"
        }
      }
    },
    "neuro-tf": {
      "commands": {
        "fit": {
          "order": 10
        }
      }
    }
  },
  "workflows": {
    "audit": {
      "common": {
        "expect_reciprocal": true,
        "passivity_tolerance": 1e-06
      }
    },
    "points": {
      "commands": {
        "generate": {
          "decimal_places": 6,
          "method": "maximin-lhs"
        },
        "suggest-additional": {
          "acquisition": "gp-ucb",
          "exploration_weight": 2.0,
          "min_distance": 0.05
        }
      }
    }
  }
}
